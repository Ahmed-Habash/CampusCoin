@model ChangePasswordForm
@{ ViewData["Title"] = "Change password"; }

<div style="max-width: 540px; margin: 0 auto; text-align: center;">
    <a class="back-link" asp-controller="Settings" asp-action="Index" style="display: inline-block; margin-bottom: 16px;">← Back to settings</a>
    <div class="page-heading" style="margin-bottom: 24px; display: flex; flex-direction: column; align-items: center; text-align: center;">
        <div>
            <span class="eyebrow" style="color: var(--signal); letter-spacing: 1.5px;">ACCOUNT SECURITY</span>
            <h1 style="font-size: 32px; font-weight: 800; margin: 8px 0 6px; letter-spacing: -1px;">Change your password.</h1>
            <p style="color: var(--muted); font-size: 13px; max-width: 440px; margin: 0 auto;">Confirm your current password, then choose a new one with at least 8 characters.</p>
        </div>
    </div>

    <section class="panel form-panel security-form" style="padding: 32px; border-radius: 20px; box-shadow: var(--shadow); text-align: left; margin: 0 auto;">
        <form method="post">
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            @foreach (var field in new[] { (Name:"CurrentPassword", Label:"Current password", Auto:"current-password"), (Name:"NewPassword", Label:"New password", Auto:"new-password"), (Name:"ConfirmPassword", Label:"Confirm new password", Auto:"new-password") }) {
                <div style="margin-bottom: 16px;">
                    <label for="@field.Name" style="font-weight: 700; font-size: 12px; margin-bottom: 6px; display: block;">@field.Label</label>
                    <div class="password-field">
                        <input type="password" id="@field.Name" name="@field.Name" autocomplete="@field.Auto" required style="width: 100%; min-height: 44px; border-radius: 12px;" />
                        <button type="button" class="password-toggle" data-password-target="@field.Name" aria-controls="@field.Name" aria-label="Show @field.Label.ToLowerInvariant()" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/><path class="eye-slash" d="m3 3 18 18"/></svg><span>Show</span></button>
                    </div>
                    @if(field.Name=="NewPassword"){<small class="field-help" style="display: block; margin-top: 4px; font-size: 11px; color: var(--muted);">Use 8 or more characters with uppercase, lowercase, a number, and a symbol.</small>}
                </div>
            }
            <div class="form-actions" style="margin-top: 24px; display: flex; gap: 10px; justify-content: flex-end;">
                <a class="button secondary" asp-controller="Settings" asp-action="Index">Cancel</a>
                <button class="button" type="submit">Update password</button>
            </div>
        </form>
    </section>
</div>

