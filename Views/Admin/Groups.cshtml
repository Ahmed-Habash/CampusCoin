@model CampusCoin.ViewModels.AdminGroupFilterViewModel
@{
    ViewData["Title"] = "Admin Group Management";
    ViewData["HeaderEyebrow"] = "Admin oversight";
    ViewData["HeaderTitle"] = "Group management";
    ViewData["HeaderLead"] = "Search, filter, inspect member balances, soft disable, or hard delete student groups.";
    ViewData["HeaderPrimaryText"] = "⚙ System controls";
    ViewData["HeaderPrimaryController"] = "Admin";
    ViewData["HeaderPrimaryAction"] = "GroupSettings";
}
<partial name="_PageHeader" />

<section class="panel" style="margin-bottom:18px;">
    <form method="get" asp-action="Groups" style="display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;">
        <div style="flex:1;min-width:220px;">
            <label style="font-size:12px;color:var(--text-muted);">Search Query</label>
            <input type="text" name="q" value="@Model.SearchQuery" class="form-control" placeholder="Group name, creator or member email..." />
        </div>
        <div style="width:140px;">
            <label style="font-size:12px;color:var(--text-muted);">Status</label>
            <select name="status" class="form-control">
                <option value="">All Statuses</option>
                <option value="active" selected="@(Model.StatusFilter=="active")">Active Only</option>
                <option value="disabled" selected="@(Model.StatusFilter=="disabled")">Disabled Only</option>
            </select>
        </div>
        <div style="width:140px;">
            <label style="font-size:12px;color:var(--text-muted);">From Date</label>
            <input type="date" name="from" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div style="width:140px;">
            <label style="font-size:12px;color:var(--text-muted);">To Date</label>
            <input type="date" name="to" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div style="display:flex;gap:8px;">
            <button type="submit" class="button">Filter Groups</button>
            <a asp-action="Groups" class="button secondary">Reset</a>
        </div>
    </form>
</section>

<section class="panel">
    <div class="table-responsive">
        <table class="table" style="width:100%;">
            <thead>
                <tr>
                    <th>Group Name</th>
                    <th>Creator</th>
                    <th>Members</th>
                    <th>Creation Date</th>
                    <th>Last Activity</th>
                    <th>Total Expenses</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Groups.Any())
                {
                    <tr>
                        <td colspan="8" style="text-align:center;padding:30px;color:var(--text-muted);">No roommate or friend groups match your search criteria.</td>
                    </tr>
                }
                else
                {
                    @foreach (var g in Model.Groups)
                    {
                        <tr>
                            <td>
                                <strong>@g.Name</strong>
                            </td>
                            <td>
                                <div>@g.CreatorName</div>
                                <small style="color:var(--text-muted);">@g.CreatorEmail</small>
                            </td>
                            <td><span class="pill primary">@g.MemberCount / @g.MaxMembers</span></td>
                            <td>@g.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>@g.LastActivityAt.ToString("MMM dd, HH:mm")</td>
                            <td><strong>@Currency.Format(g.TotalExpensesCents)</strong></td>
                            <td>
                                @if (g.IsDisabled)
                                {
                                    <span class="badge danger">Disabled</span>
                                }
                                else
                                {
                                    <span class="badge success">Active</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <a asp-action="GroupDetails" asp-route-id="@g.Id" class="button secondary small">Inspect Details ↗</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
