@model RecurringTransactionForm
@{ ViewData["Title"] = Model.Id == 0 ? "Add recurring" : "Edit recurring"; }
<a class="back-link" asp-action="Index">← Back to recurring transactions</a><div class="page-heading"><div><span class="eyebrow">MAKE A LITTLE ROUTINE</span><h1>@ViewData["Title"]</h1><p>Campus Coin will create each due entry in your transaction history.</p></div></div>
<section class="panel form-panel"><form method="post" id="recurring-edit-form"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Description"></label><input asp-for="Description" placeholder="e.g. Monthly allowance" /><div class="form-grid"><div><label asp-for="Amount">Amount (@Currency.Code)</label><input asp-for="Amount" type="number" min="0.01" max="1000000" step="0.01" placeholder="0.00" inputmode="decimal" /></div><div><label asp-for="Frequency"></label><select asp-for="Frequency" asp-items="Html.GetEnumSelectList<RecurrenceFrequency>()"></select></div></div><label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="ViewBag.Categories"><option value="">Choose a category</option></select><label asp-for="StartDate"></label><input asp-for="StartDate" type="date" /><small class="field-help">The first entry is created on this date, then repeated using the selected frequency.</small>@if(Model.Id>0){<label class="checkbox"><input asp-for="IsActive" /> Keep this routine active</label>}<div class="form-actions">@if(Model.Id!=0){<button type="submit" form="recurring-delete-form" class="danger-link" style="white-space:nowrap">Remove recurring transaction</button>}<div style="margin-left:auto;display:flex;gap:8px;align-items:center"><a asp-action="Index" class="button secondary">Cancel</a><button class="button" type="submit">Save recurring ↗</button></div></div></form>@if(Model.Id!=0){<form asp-action="Delete" asp-route-id="@Model.Id" method="post" id="recurring-delete-form" class="delete-form" data-confirm="Remove this recurring transaction? Existing transactions will stay." style="display:none"></form>}</section>


