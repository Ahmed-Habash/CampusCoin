@model string
<div class="password-field">
    <input type="password" id="@Model" name="@Model" autocomplete="@(ViewContext.RouteData.Values["action"]?.ToString()=="Login" ? "current-password" : "new-password")" required aria-describedby="@(ViewContext.RouteData.Values["action"]?.ToString()=="Register" ? "password-help" : null)" />
    <button type="button" class="password-toggle" data-password-target="@Model" aria-controls="@Model" aria-label="Show @(Model=="ConfirmPassword" ? "confirm password" : "password")" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/><path class="eye-slash" d="m3 3 18 18"/></svg><span>Show</span>
    </button>
</div>
